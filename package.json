{
  "name": "7902-wiki",
  "description": "Markham FireBirds Wiki - Docusaurus-based knowledge management system",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "cd website && npm run start",
    "build": "cd website && npm run build",
    "serve": "cd website && npm run serve",
    "clear": "cd website && npm run clear",
    "sync": "python -m backend.services.sync.drive_sync",
    "install:all": "cd website && npm install && pip install -r requirements.txt"
  },
  "engines": {
    "npm": ">=9.0.0",
    "node": ">=20.0.0"
  },
  "keywords": [
    "wiki",
    "frc",
    "knowledge-management",
    "docusaurus"
  ]
}